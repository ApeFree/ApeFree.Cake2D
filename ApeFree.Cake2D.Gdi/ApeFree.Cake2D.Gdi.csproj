<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net452;net472;net6.0-windows;net8.0-windows;net10.0-windows;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Company>ApeFree</Company>
    <Authors>Guijie Lee</Authors>
    <Copyright>Copyright © 2022-2026 ApeFree, All Rights Reserved.</Copyright>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <Title>Cake2D.Gdi</Title>
    <Product>ApeFree.Cake2D.Gdi</Product>
    <Description>基于 GDI+ 的 Cake2D 渲染接口与控件库</Description>
    <Version>1.1.0.0-alpha61112</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageIcon>ApeFree_64px.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Windows 平台专有配置（启用 Windows Forms 支持） -->
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-windows')) or '$(TargetFramework)' == 'net452' or '$(TargetFramework)' == 'net472'">
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);CAKE2D_WINFORMS</DefineConstants>
  </PropertyGroup>

  <!-- 非 Windows 桌面目标框架下排除 WinForms 控件源码 -->
  <ItemGroup Condition="!($(TargetFramework.EndsWith('-windows')) or '$(TargetFramework)' == 'net452' or '$(TargetFramework)' == 'net472')">
    <Compile Remove="Controls\**" />
  </ItemGroup>

  <!-- .NET Framework 专有引用 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net452' or '$(TargetFramework)' == 'net472'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- netstandard2.0 下引用 System.Drawing.Common -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Drawing.Common" Version="4.7.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApeFree.Cake2D\ApeFree.Cake2D.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\ApeFree_64px.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
