<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net6.0;net8.0;net10.0;net462;net472;net6.0-windows;net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Company>ApeFree</Company>
    <Authors>Guijie Lee</Authors>
    <Copyright>Copyright © 2022-2026 ApeFree, All Rights Reserved.</Copyright>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <Title>Cake2D.Skia</Title>
    <Product>ApeFree.Cake2D.Skia</Product>
    <Description>基于 SkiaSharp 的 Cake2D 渲染接口与控件库</Description>
    <Version>1.1.0.0-alpha61112</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageIcon>ApeFree_64px.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Windows 平台专有配置（启用 Windows Forms 支持） -->
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-windows')) or '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'net472'">
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);CAKE2D_WINFORMS</DefineConstants>
  </PropertyGroup>

  <!-- 非 Windows 桌面目标框架下排除 WinForms 控件源码 -->
  <ItemGroup Condition="!($(TargetFramework.EndsWith('-windows')) or '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'net472')">
    <Compile Remove="Controls\**" />
  </ItemGroup>

  <!-- 纯 SkiaSharp 核心包：全平台无差别引用 -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <!-- WinForms 控件包：仅在编译 Windows 版本时引用 -->
  <ItemGroup Condition="$(TargetFramework.EndsWith('-windows')) or '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'net472'">
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApeFree.Cake2D\ApeFree.Cake2D.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\ApeFree_64px.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
